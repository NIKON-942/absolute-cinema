# Copy to /opt/absolute-cinema/.env on the VM. Never commit actual secrets.
# IP-only start: SITE_ADDRESS=http://YOUR_PUBLIC_IP, CLIENT_URL=http://YOUR_PUBLIC_IP
# Domain + automatic HTTPS: SITE_ADDRESS=cinema.example.com, CLIENT_URL=https://cinema.example.com
SITE_ADDRESS=http://YOUR_PUBLIC_IP
CLIENT_URL=http://YOUR_PUBLIC_IP

DB_NAME=absolutecinema
DB_USER=cinema
DB_PASSWORD=

# CPU budget shared by the API and the sequential transcoder.
BACKEND_CPUS=1.5
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Used only when there is no administrator. Existing passwords are never reset.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Keep false for the educational demo; mock checkout does not collect money.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Use authenticated SMTP on 587 (STARTTLS); Mailpit is dev-only.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AbsoluteCinema <no-reply@example.com>"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example for the current public site; register this exact URI in Google Auth Platform.
GOOGLE_CALLBACK_URL=https://absolutecine.duckdns.org/api/auth/google/callback
# For this domain also set SITE_ADDRESS=absolutecine.duckdns.org
# and CLIENT_URL=https://absolutecine.duckdns.org (a single origin, no trailing slash).

# Tracing stays disabled until an actual collector is configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
