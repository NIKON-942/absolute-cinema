# ===== Backend =====
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cinema
DB_PASSWORD=cinema
DB_NAME=absolutecinema

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Stripe (leave STRIPE_ENABLED=false to use the built-in mock payment simulator)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (Mailpit by default)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AbsoluteCinema <no-reply@absolutecinema.local>"

# OpenTelemetry / Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ===== Frontend (Vite; consumed via VITE_ prefix) =====
VITE_API_URL=http://localhost:4000/api
